# LingBot-Map Service — Environment Variables

# Application Environment
APP_ENV=development
PORT=10001

# Logging
LOG_LEVEL=info
PYTHONUNBUFFERED=1

# Redis Configuration (optional, for caching)
REDIS_HOST=redis
REDIS_PORT=6379

# Cache Settings
LINGBOT_CACHE_DIR=/tmp/lingbot-cache
LINGBOT_MODELS_DIR=/tmp/lingbot-models

# API Keys (if needed for external services)
# OPENROUTER_API_KEY=your-key-here
# HUGGINGFACE_TOKEN=your-token-here

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://qurabia.com

# Security
ADMIN_ACCESS_CODE=LINGBOT-ADMIN-DEV-CODE
