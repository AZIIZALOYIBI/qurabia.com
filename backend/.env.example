APP_ENV=dev

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_S=60
MAX_BODY_BYTES=262144

LEARNING_MAX_EVENTS=500
LEARNING_DB_PATH=
LEARNING_DB_MAX_ROWS=25000

# ── مفاتيح التشفير والتوقيع الرقمي ────────────────────────────────────────
# يُطلب تعيين هذه المفاتيح في الإنتاج (APP_ENV=production)
KEM_MASTER_SEED=
DSA_SIGNING_KEY=

# ── مفتاح JWT للمصادقة ────────────────────────────────────────────────────
# إذا لم يُعيّن، سيُستخدم KEM_MASTER_SEED + "qurabia-auth-2026" كبديل
JWT_SECRET=

# ── Vault (اختياري) ──────────────────────────────────────────────────────
VAULT_ADDR=
VAULT_TOKEN=

# ── مفاتيح API للخدمات الخارجية (اختياري) ────────────────────────────────
# يمكن استخدام هذه المفاتيح لتفعيل خدمات الذكاء الاصطناعي الإضافية
GEMINI_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── GLM-4.7 vLLM Server ───────────────────────────────────────────────────────
# عنوان خادم vLLM الذي يخدم نموذج GLM-4.7-FP8
# تشغيل الخادم:
#   vllm serve zai-org/GLM-4.7-FP8 \
#     --tensor-parallel-size 4 \
#     --speculative-config.method mtp \
#     --speculative-config.num_speculative_tokens 1 \
#     --tool-call-parser glm47 \
#     --reasoning-parser glm45 \
#     --enable-auto-tool-choice \
#     --served-model-name glm-4.7-fp8
VLLM_BASE_URL=http://localhost:8000
GLM_MODEL_NAME=glm-4.7-fp8
GLM_TIMEOUT_S=30.0
